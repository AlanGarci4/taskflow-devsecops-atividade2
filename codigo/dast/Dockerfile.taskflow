FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir "Flask>=3,<4" "Werkzeug>=3,<4"

COPY codigo/dast ./codigo/dast
COPY codigo/observabilidade ./codigo/observabilidade

ENV TASKFLOW_SECRET_KEY=devsecops-lab-secret-do-not-use-in-prod
ENV FLASK_DEBUG=false

EXPOSE 5000

CMD ["python", "codigo/dast/app_fixed_dast.py"]
